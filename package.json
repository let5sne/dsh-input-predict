{
  "name": "@let5sne/dsh-input-predict",
  "version": "1.0.1",
  "description": "Predicts your next message and shows it as the empty composer's placeholder, with Tab to accept",
  "license": "MIT",
  "author": "let5sne",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "input",
    "composer",
    "prediction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/let5sne/dsh-input-predict.git"
  },
  "homepage": "https://github.com/let5sne/dsh-input-predict#readme",
  "bugs": {
    "url": "https://github.com/let5sne/dsh-input-predict/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.2.3-0",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.3 <0.2.3-0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
